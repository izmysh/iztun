#!/usr/bin/python3
"""One-time administrator-approved setup; launch only after dropping privileges."""
import os
import pwd
import re
import stat
import subprocess
import sys
import time
from pathlib import Path


def setup(arguments):
    if os.getuid() != 0 or len(arguments) != 3:
        raise RuntimeError("Administrator authorization required")
    raw_uid = os.environ.get("SUDO_UID", "")
    if not re.fullmatch(r"[0-9]{1,10}", raw_uid) or not 0 < int(raw_uid) < 2**32 - 1:
        raise RuntimeError("No desktop user")
    account = pwd.getpwuid(int(raw_uid))
    runtime = Path(f"/run/user/{account.pw_uid}")
    info = runtime.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != account.pw_uid or info.st_mode & 0o077:
        raise RuntimeError("Unsafe desktop runtime directory")
    bus = runtime / "bus"
    if bus.is_symlink() or not stat.S_ISSOCK(bus.stat().st_mode) or bus.stat().st_uid != account.pw_uid:
        raise RuntimeError("No user session bus")
    wayland, display, authority = arguments
    environment = {
        "HOME": account.pw_dir, "USER": account.pw_name, "LOGNAME": account.pw_name,
        "PATH": "/usr/local/bin:/usr/bin:/bin", "XDG_RUNTIME_DIR": str(runtime),
        "DBUS_SESSION_BUS_ADDRESS": f"unix:path={bus}",
    }
    if wayland:
        if not re.fullmatch(r"[A-Za-z0-9_.-]{1,80}", wayland):
            raise RuntimeError("Invalid Wayland display")
        path = runtime / wayland
        if path.is_symlink() or not stat.S_ISSOCK(path.stat().st_mode) or path.stat().st_uid != account.pw_uid:
            raise RuntimeError("No Wayland display")
        environment["WAYLAND_DISPLAY"] = wayland
    elif not display:
        raise RuntimeError("No graphical session")
    if display:
        if not re.fullmatch(r":[0-9]{1,5}(?:\.[0-9]{1,3})?", display):
            raise RuntimeError("Only local X11 displays are supported")
        environment["DISPLAY"] = display
        if authority:
            environment["XAUTHORITY"] = authority
    subprocess.run(["/usr/sbin/usermod", "-aG", "amneziawg", "--", account.pw_name],
                   check=True, timeout=30, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    groups = os.getgrouplist(account.pw_name, account.pw_gid)
    original_cgroup = Path("/proc/self/cgroup").read_text()
    child = subprocess.Popen(
        ["/usr/bin/systemd-run", "--user", "--scope", "--collect", "--quiet", "--", "/usr/bin/iztun"],
        user=account.pw_uid, group=account.pw_gid, extra_groups=groups,
        env=environment, cwd=account.pw_dir, start_new_session=True,
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    # Leave the launcher's cgroup before it exits; otherwise its cleanup can kill the GUI.
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        if child.poll() is not None:
            raise RuntimeError("Desktop launch failed")
        cgroup = Path(f"/proc/{child.pid}/cgroup").read_text()
        if cgroup != original_cgroup and ".scope" in cgroup:
            return
        time.sleep(0.05)
    child.terminate()
    raise RuntimeError("Desktop launch timed out")


if __name__ == "__main__":
    try:
        setup(sys.argv[1:])
    except (RuntimeError, KeyError, OSError, subprocess.SubprocessError):
        raise SystemExit(1)
