def recovery_candidates(records):
    return sorted(
        (r for r in records if not paused_path(r["name"]).exists()
         and (r["active"] or r["service_active"] or r["enabled"] or is_wanted(r["name"]))),
        key=lambda r: (not r["active"], not r["service_active"], r["name"]),
    )


def cmd_recover():
    """Bounded retry after a real network event; honour manual Disconnect."""
    stamp = STATE_DIR / "recover.stamp"
    if stamp.exists() and time.time() - stamp.stat().st_mtime < 5:
        return
    stamp.touch(mode=0o600)
    interfaces = active_interfaces()
    candidates = recovery_candidates([profile_record(n, interfaces) for n in profile_names()])
    selected_full = next((r["name"] for r in candidates if r["full_tunnel"]), None)
    for record in candidates:
        name = record["name"]
        if record["full_tunnel"] and name != selected_full:
            continue
        for delay in (2, 5, 10):
            time.sleep(delay)
            # Lock each attempt separately: Disconnect can cancel subsequent attempts.
            with operation_lock(nonblocking=True) as acquired:
                if not acquired or paused_path(name).exists():
                    break
                try:
                    force_cleanup(name)
                    start_profile(name)
                    break
                except Exception as exc:
                    set_wanted(name, True)
                    store_last_error(name, f"Automatic recovery failed: {exc}")


COMMANDS = {
    "list": (cmd_list, 0),
    "up": (cmd_up, 1),
    "down": (cmd_down, 1),
    "down-all": (cmd_down_all, 0),
    "repair": (cmd_repair, 1),
    "autostart": (cmd_autostart, 2),
    "import": (cmd_import, 2),
    "rename": (cmd_rename, 2),
    "read-config": (cmd_read_config, 1),
    "save-config": (cmd_save_config, 2),
    "delete": (cmd_delete, 1),
    "status": (cmd_status, 1),
    "diagnostics": (cmd_diagnostics, 1),
    "recover": (cmd_recover, 0),
}
MUTATING_COMMANDS = {"up", "down", "down-all", "repair", "autostart", "import", "delete", "rename", "save-config"}
SOCKET_COMMANDS = set(COMMANDS) - {"recover"}


def dispatch(args):
    if not args or args[0] not in COMMANDS:
        raise RuntimeError("Unsupported command")
    function, count = COMMANDS[args[0]]
    if len(args[1:]) != count:
        raise RuntimeError("Invalid number of arguments")
    if args[0] in MUTATING_COMMANDS:
        with operation_lock(nonblocking=True) as acquired:
            if not acquired:
                raise RuntimeError("Another network operation is already in progress")
            function(*args[1:])
    else:
        function(*args[1:])


def peer_is_authorized(connection):
    _pid, uid, gid = struct.unpack("3i", connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
    if uid == 0:
        return True
    try:
        allowed_gid = grp.getgrnam("amneziawg").gr_gid
    except KeyError:
        return False
    if gid == allowed_gid:
        return True
    try:
        groups = os.getgrouplist(pwd.getpwuid(uid).pw_name, gid)
    except (KeyError, OSError):
        groups = []
    return allowed_gid in groups


def serve_connection(connection):
    response = {"ok": False, "output": ""}
    try:
        if not peer_is_authorized(connection):
            raise RuntimeError("Access denied")
        deadline = time.monotonic() + 5
        data = bytearray()
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise RuntimeError("Request read deadline exceeded")
            connection.settimeout(remaining)
            chunk = connection.recv(65536)
            if not chunk:
                break
            data.extend(chunk)
            if len(data) > MAX_REQUEST_BYTES:
                raise RuntimeError("Request too large")
        request = json.loads(data.decode("utf-8"))
        if not isinstance(request, dict):
            raise RuntimeError("Malformed request")
        args = request.get("args")
        if not isinstance(args, list) or not args or len(args) > 3 or not all(isinstance(item, str) for item in args):
            raise RuntimeError("Malformed request")
        if args[0] not in SOCKET_COMMANDS:
            raise RuntimeError("Unsupported command")
        captured = io.StringIO()
        with redirect_stdout(captured):
            dispatch(args)
        response = {"ok": True, "output": captured.getvalue().strip()}
    except (RuntimeError, SystemExit) as exc:
        response = {"ok": False, "error": redact_text(exc)}
    except Exception:
        response = {"ok": False, "error": "Request failed. Check service state and profile permissions."}
    try:
        connection.settimeout(5)
        connection.sendall((json.dumps(response) + "\n").encode("utf-8"))
    except OSError:
        pass


def main():
    ensure_dirs()
    if len(sys.argv) > 1 and sys.argv[1] == "--socket":
        with socket.fromfd(sys.stdin.fileno(), socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            serve_connection(connection)
        return 0
    try:
        if len(sys.argv) == 3 and sys.argv[1] in {"service-up", "service-down"}:
            {"service-up": service_up, "service-down": service_down}[sys.argv[1]](profile_name(sys.argv[2]))
            return 0
        dispatch(sys.argv[1:])
        return 0
    except (RuntimeError, SystemExit) as exc:
        print(redact_text(exc), file=sys.stderr)
        return 1
    except Exception:
        print("Operation failed; check profile permissions and service state", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
