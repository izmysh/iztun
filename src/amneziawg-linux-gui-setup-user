#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
    echo "Run this command through sudo." >&2
    exit 1
fi

target_user="${1:-${SUDO_USER:-}}"
if [ -z "$target_user" ] || [ "$target_user" = "root" ]; then
    echo "Usage: sudo amneziawg-linux-gui-setup-user USERNAME" >&2
    exit 1
fi

if ! id "$target_user" >/dev/null 2>&1; then
    echo "User not found: $target_user" >&2
    exit 1
fi

usermod -aG amneziawg "$target_user"
echo "Added $target_user to the amneziawg group. Sign out and sign back in before starting the GUI."
