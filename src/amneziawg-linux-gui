    def export_diagnostics(self, _item, name):
        owner = self.begin_interaction()
        if owner is None:
            return

        def choose_and_save(report):
            chooser = Gtk.FileChooserDialog(
                title=tr("Save diagnostic report"), transient_for=self.window, action=Gtk.FileChooserAction.SAVE
            )
            chooser.add_buttons(tr("Cancel"), Gtk.ResponseType.CANCEL, tr("Save"), Gtk.ResponseType.OK)
            chooser.set_do_overwrite_confirmation(True)
            chooser.set_current_name(f"amneziawg-{name}-diagnostics.txt")
            chooser.set_local_only(True)
            chooser.set_current_folder(pwd.getpwuid(os.getuid()).pw_dir)

            def respond(response):
                if response == Gtk.ResponseType.OK:
                    filename = chooser.get_filename()
                    self.interaction_call(
                        owner, lambda: write_diagnostics(filename, report),
                        lambda _result: self.show_info(tr("Diagnostic report saved"),
                                                       tr("The report contains no keys or profile contents."), owner=owner),
                    )
                else:
                    self.end_interaction(owner)

            self.present_dialog(chooser, owner, respond)

        self.interaction_call(owner, lambda: self.helper("diagnostics", name), choose_and_save)

    def import_profile(self, *_):
        owner = self.begin_interaction()
        if owner is None:
            return
        chooser = Gtk.FileChooserDialog(
            title=tr("Import AmneziaWG configuration"), transient_for=self.window, action=Gtk.FileChooserAction.OPEN
        )
        chooser.add_buttons(tr("Cancel"), Gtk.ResponseType.CANCEL, tr("Import"), Gtk.ResponseType.OK)
        file_filter = Gtk.FileFilter()
        file_filter.set_name(tr("Configuration files (*.conf)"))
        file_filter.add_pattern("*.conf")
        chooser.add_filter(file_filter)
        chooser.set_local_only(True)
        chooser.set_current_folder(pwd.getpwuid(os.getuid()).pw_dir)

        def respond(response):
            if response != Gtk.ResponseType.OK:
                self.end_interaction(owner)
                return
            filename = chooser.get_filename()
            self.interaction_call(owner, lambda: read_import(filename),
                                  lambda text: self.name_import(owner, filename, text))

        self.present_dialog(chooser, owner, respond)

    def name_import(self, owner, filename, config_text):
        default_name = re.sub(r"[^A-Za-z0-9_.+-]", "-", Path(filename).stem)[:15] or "awg0"
        dialog = Gtk.Dialog(title=tr("Profile name"), transient_for=self.window)
        dialog.add_buttons(tr("Cancel"), Gtk.ResponseType.CANCEL, tr("Save"), Gtk.ResponseType.OK)
        entry = Gtk.Entry(text=default_name)
        entry.set_max_length(15)
        for side in ("top", "bottom", "start", "end"):
            getattr(entry, f"set_margin_{side}")(15)
        dialog.get_content_area().add(entry)
        def respond(response):
            name = entry.get_text().strip()
            self.end_interaction(owner)
            if response == Gtk.ResponseType.OK:
                self.run_action(["import", config_text, name])

        self.present_dialog(dialog, owner, respond)

    def delete_profile(self, _item, name):
        owner = self.begin_interaction()
        if owner is None:
            return
        dialog = Gtk.MessageDialog(
            transient_for=self.window,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text=tr(f"Delete profile ‘{name}’?"),
        )
        dialog.format_secondary_text(tr("The tunnel will be disconnected and the profile moved to protected trash."))
        def respond(response):
            self.end_interaction(owner)
            if response == Gtk.ResponseType.OK:
                self.run_action(["delete", name])

        self.present_dialog(dialog, owner, respond)

    def show_error(self, message):
        if self.quitting:
            return False
        self.action_feedback = (message, time.monotonic())
        self.update_footer()
        if self.error_visible:
            self.error_dialog.present()
            return False
        self.error_visible = True
        dialog = Gtk.MessageDialog(
            transient_for=self.dialog or self.window,
            modal=True,
            destroy_with_parent=True,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.CLOSE,
            text=tr("IZtun operation failed"),
        )
        self.error_dialog = dialog
        self.update_controls()
        dialog.format_secondary_text(message)

        def destroyed(_dialog):
            self.error_dialog = None
            self.error_visible = False
            self.update_controls()

        dialog.connect("response", lambda *_: dialog.destroy())
        dialog.connect("destroy", destroyed)
        dialog.show_all()
        return False

    def on_close(self, *_):
        if self.quitting:
            return False
        if self.dialog or self.error_dialog:
            (self.error_dialog or self.dialog).present()
        else:
            self.window.hide()
        return True

    def quit_app(self, *_):
        self.stop_background_work()
        self.quit()

    def stop_background_work(self):
        if self.quitting:
            return
        self.quitting = True
        if self.refresh_timer is not None:
            GLib.source_remove(self.refresh_timer)
            self.refresh_timer = None
        with self.socket_lock:
            for client in self.sockets:
                try:
                    client.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass
        for dialog in (self.error_dialog, self.dialog):
            if dialog:
                dialog.destroy()

    def do_shutdown(self):
        self.stop_background_work()
        Gtk.Application.do_shutdown(self)


def main():
    if "--version" in sys.argv:
        print(f"IZtun {APP_VERSION}")
        return 0
    return AmneziaWGApplication().run(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
