        )
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.update_tray([])

    def update_tray(self, profiles):
        self.profiles = profiles
        signature = (self.controls_locked(), tuple((p["name"], p.get("label"), p["active"], p["health"]) for p in profiles))
        if not self.indicator or self.tray_signature == signature:
            return
        self.tray_signature = signature
        active = any(profile["active"] for profile in profiles)
        self.indicator.set_icon_full("network-vpn" if active else "network-vpn-disconnected", "IZtun")
        menu = Gtk.Menu()
        open_item = Gtk.MenuItem(label=tr("Open IZtun"))
        open_item.connect("activate", lambda *_: (self.window.show_all(), self.window.present()))
        menu.append(open_item)
        if profiles:
            menu.append(Gtk.SeparatorMenuItem())
            for profile in profiles:
                state = HEALTH_LABELS.get(profile["health"], profile["health"])
                item = Gtk.MenuItem(label=f"{profile.get('label', profile['name'])} — {state}")
                item.set_sensitive(not self.controls_locked())
                item.connect(
                    "activate",
                    lambda _item, name=profile["name"], active_now=profile["active"]: self.run_action(
                        ["down" if active_now else "up", name]
                    ),
                )
                menu.append(item)
            menu.append(Gtk.SeparatorMenuItem())
        disconnect_item = Gtk.MenuItem(label=tr("Disconnect all tunnels"))
        disconnect_item.set_sensitive(active and not self.controls_locked())
        disconnect_item.connect("activate", lambda *_: self.run_action(["down-all"]))
        menu.append(disconnect_item)
        quit_item = Gtk.MenuItem(label=tr("Quit"))
        quit_item.connect("activate", self.quit_app)
        menu.append(quit_item)
        menu.show_all()
        self.indicator.set_menu(menu)

    def helper(self, *args):
        request = (json.dumps({"args": list(args)}, ensure_ascii=False) + "\n").encode()
        if len(request) > MAX_REQUEST_BYTES:
            raise ValueError("Helper request is too large")
        deadline = time.monotonic() + READ_TIMEOUTS.get(args[0], ACTION_TIMEOUT)
        data = bytearray()

        def remaining(client):
            timeout = deadline - time.monotonic()
            if timeout <= 0:
                raise TimeoutError()
            client.settimeout(timeout)

        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
                with self.socket_lock:
                    if self.quitting:
                        raise RuntimeError("Application is closing")
                    self.sockets.add(client)
                try:
                    remaining(client)
                    client.connect(HELPER_SOCKET)
                    remaining(client)
                    client.sendall(request)
                    client.shutdown(socket.SHUT_WR)
                    while True:
                        remaining(client)
                        chunk = client.recv(min(65536, MAX_RESPONSE_BYTES + 1 - len(data)))
                        if not chunk:
                            break
                        data.extend(chunk)
                        if len(data) > MAX_RESPONSE_BYTES:
                            raise RuntimeError("Helper response is too large")
                finally:
                    with self.socket_lock:
                        self.sockets.discard(client)
        except TimeoutError as exc:
            message = "Helper request timed out"
            if args[0] not in READ_TIMEOUTS:
                message += "; the operation may still finish. Check status before retrying."
            raise RuntimeError(message) from exc
        except PermissionError as exc:
            raise RuntimeError(tr("Access denied. Add your account to the amneziawg group and sign in again.")) from exc
        except FileNotFoundError as exc:
            raise RuntimeError(tr("The privileged helper is not running. Start amneziawg-linux-gui.socket.")) from exc
        try:
            response = json.loads(data.decode("utf-8"))
        except (ValueError, UnicodeError, RecursionError) as exc:
            raise RuntimeError("Malformed helper response") from exc
        if not isinstance(response, dict) or type(response.get("ok")) is not bool:
            raise RuntimeError("Malformed helper response")
        output = response.get("output", "")
        error = response.get("error", "")
        if not isinstance(output, str) or not isinstance(error, str):
            raise RuntimeError("Malformed helper response")
        if not response["ok"]:
            raise RuntimeError(error or tr("Unknown error"))
        return output

    def async_call(self, function, done=None, finished=None, quiet=False, *, lane="aux", failed=None):
        # One request per lane, including its pending GTK callback; no work queue.
        if self.quitting or lane in self.pending_calls:
            return False
        if lane not in {"poll", "action", "aux"}:
            raise ValueError("Unknown request lane")
        self.pending_calls.add(lane)

        def deliver(result, error):
            self.pending_calls.discard(lane)
            if self.quitting:
                return False
            try:
                if error is None:
                    if done:
                        done(result)
                elif failed:
                    failed(error)
                elif quiet:
                    self.poll_error = error
                    self.update_footer()
                else:
                    self.show_error(error)
            except Exception as exc:
                self.show_error(str(exc))
            finally:
                if finished:
                    finished()
            return False

        def worker():
            try:
                result, error = function(), None
            except Exception as exc:
                result, error = None, str(exc)
            GLib.idle_add(deliver, result, error)

        try:
            threading.Thread(target=worker, daemon=True, name=f"iztun-{lane}").start()
        except Exception as exc:
            deliver(None, str(exc))
        return True

    def refresh(self, *_, timer=False):
        if self.quitting:
            return False
        if self.refreshing:
            if not timer:
                self.refresh_pending = True
            return True
        if timer and not self.window.get_visible() and time.monotonic() - self.last_refresh < 15:
            return True
        self.last_refresh = time.monotonic()
        self.refreshing = True
        generation = self.refresh_generation
        self.refresh_pending = False

        def complete(profiles):
            if generation == self.refresh_generation:
                self.render_profiles(profiles)

        def failed(message):
            if generation == self.refresh_generation:
                self.poll_error = message
                self.update_footer()

        def finished():
            self.refreshing = False
            if self.refresh_pending or generation != self.refresh_generation:
                self.refresh()

        if not self.async_call(lambda: parse_profiles(self.helper("list")), complete, finished,
                               lane="poll", failed=failed):
            self.refreshing = False
        return True

    def clear_list(self):
        for child in self.listbox.get_children():
            child.destroy()
        self.profile_rows = {}
        self.column_groups = {width: Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL)
                              for width in (24, 72, 132, 36)}

    def profile_detail_text(self, profile):
        if profile["active"]:
            return ""
        if profile.get("last_error"):
            return tr("Use Repair connection to clean up and reconnect")
        if profile["enabled"]:
            return tr("Will reconnect automatically")
        return ""

    def render_profiles(self, profiles):
        self.poll_error = ""
        now = time.monotonic()
        current_names = set()
        for profile in profiles:
            name = profile["name"]
            current_names.add(name)
            rx, tx = int(profile.get("rx", 0)), int(profile.get("tx", 0))
            old = self.previous_traffic.get(name)
            if profile["active"] and old and old[3]:
                elapsed = max(now - old[2], 0.2)
                profile["rx_rate"] = max(0, (rx - old[0]) / elapsed)
                profile["tx_rate"] = max(0, (tx - old[1]) / elapsed)
            else:
                profile["rx_rate"] = profile["tx_rate"] = 0
            self.previous_traffic[name] = (rx, tx, now, profile["active"])
        self.previous_traffic = {key: value for key, value in self.previous_traffic.items() if key in current_names}
        self.update_tray(profiles)
        self.update_footer()
        self.stack.set_visible_child_name("profiles" if profiles else "empty")
        structure = tuple(p["name"] for p in profiles)
        if structure != self.profile_structure:
            self.clear_list()
            for profile in profiles:
                row = self.profile_row(profile)
                self.profile_rows[profile["name"]] = row
                self.listbox.add(row)
            self.listbox.show_all()
            self.profile_structure = structure
        else:
            for profile in profiles:
                row = self.profile_rows.get(profile["name"])
                if row:
                    self.update_profile_row(row, profile)
        return False

    def update_footer(self):
        profiles = getattr(self, "profiles", [])
        active = [p for p in profiles if p["active"]]
        state = ""
        if self.operation:
            verb, name = self.operation
            labels = {"up": "Connecting…", "down": "Disconnecting…", "down-all": "Disconnecting…",
                      "repair": "Repairing connection…", "import": "Importing…", "delete": "Removing…",
                      "rename": "Renaming…", "save-config": "Saving…", "autostart": "Saving…"}
            state = tr(labels.get(verb, "Working…"))
            profile = next((p for p in profiles if p["name"] == name), None)
            if profile:
                state += " · " + profile.get("label", name)
                if verb in {"up", "repair"} and profile["active"] and not profile.get("latest_handshake"):
                    state += " · " + tr("Waiting for handshake…")
        elif self.action_feedback and time.monotonic() - self.action_feedback[1] < 12:
            state = self.action_feedback[0]
        elif active:
            if len(active) == 1:
                profile = active[0]
                state = profile.get("label", profile["name"]) + " · " + HEALTH_LABELS.get(profile["health"], profile["health"])
            else:
                state = tr(f"Active tunnels: {len(active)}")
        if self.poll_error:
            state = self.poll_error
        self.notice.set_text(state)
        self.notice.set_tooltip_text(state or None)
        if active and not self.poll_error:
            rx_rate, tx_rate, rx, tx = (sum(p.get(key, 0) for p in active)
                                       for key in ("rx_rate", "tx_rate", "rx", "tx"))
            traffic = (f"↓ {human_bytes(rx_rate)}/s   ↑ {human_bytes(tx_rate)}/s"
                       f"   ·   Total ↓ {human_bytes(rx)}   ↑ {human_bytes(tx)}")
            self.traffic.set_text(traffic)
            self.traffic.set_tooltip_text(tr("Combined VPN traffic for the current tunnel sessions; counters reset on reconnect."))
        else:
            self.traffic.set_text("")
            self.traffic.set_tooltip_text(None)

    def profile_grid(self):
        grid = Gtk.Grid(column_spacing=12)
        grid.set_border_width(12)
        grid.set_hexpand(True)
        return grid

    def control_cell(self, widget, width):
        cell = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        cell.set_size_request(width, -1)
        cell.set_halign(Gtk.Align.CENTER)
        cell.set_valign(Gtk.Align.CENTER)
        widget.set_halign(Gtk.Align.CENTER)
        widget.set_valign(Gtk.Align.CENTER)
        cell.set_center_widget(widget)
        self.column_groups[width].add_widget(cell)
        return cell

    def update_profile_header(self, row, previous):
        if previous is not None:
            row.set_header(None)
        elif row.get_header() is None:
            header = self.profile_header()
            header.show_all()
            row.set_header(header)

    def profile_header(self):
        grid = self.profile_grid()
        grid.set_margin_top(4)
        grid.attach(self.control_cell(Gtk.Label(), 24), 0, 0, 1, 1)
        label = Gtk.Label(label=tr("Profile"), xalign=0)
        label.set_hexpand(True)
        label.get_style_context().add_class("dim-label")
        grid.attach(label, 1, 0, 1, 1)
        for column, title, width in ((2, "Auto-connect", 72), (3, "Connection", 132), (4, "", 36)):
            label = Gtk.Label(label=tr(title))
            label.get_style_context().add_class("dim-label")
            grid.attach(self.control_cell(label, width), column, 0, 1, 1)
        return grid

    def profile_row(self, profile):
        row = Gtk.ListBoxRow()
        row.set_activatable(False)
        row.set_selectable(False)
        grid = self.profile_grid()
        dot = Gtk.Label(label="●")
        dot.set_tooltip_text(HEALTH_LABELS.get(profile["health"], profile["health"]))
        dot.get_style_context().add_class("health-dot")
        dot.get_style_context().add_class(f"health-{profile['health']}")
        grid.attach(self.control_cell(dot, 24), 0, 0, 1, 1)

        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        text_box.set_hexpand(True)
        text_box.set_valign(Gtk.Align.CENTER)
        title = Gtk.Label()
        title.set_xalign(0)
        title.set_ellipsize(Pango.EllipsizeMode.END)
        title.set_max_width_chars(36)
        badge = profile["protocol"] + (" • Full tunnel" if profile["full_tunnel"] else "")
        title.set_markup(
            f"<span weight='600' size='large'>{GLib.markup_escape_text(profile.get('label', profile['name']))}</span>  "
            f"<span color='#77767b'>{GLib.markup_escape_text(badge)}</span>"
        )
        text_box.pack_start(title, False, False, 0)
        state = Gtk.Label(label=HEALTH_LABELS.get(profile["health"], profile["health"]))
        state.set_xalign(0)
        text_box.pack_start(state, False, False, 0)
        detail = Gtk.Label(label=self.profile_detail_text(profile))
        detail.set_xalign(0)
        detail.set_ellipsize(Pango.EllipsizeMode.END)
        detail.set_max_width_chars(55)
        detail.set_tooltip_text(self.profile_detail_text(profile))
        detail.get_style_context().add_class("dim-label")
        detail.set_no_show_all(True)
        detail.set_visible(bool(self.profile_detail_text(profile)))
        text_box.pack_start(detail, False, False, 0)
        grid.attach(text_box, 1, 0, 1, 1)

        autostart = Gtk.Switch(active=profile["enabled"])
        autostart.set_tooltip_text(tr("Connect at boot. Active tunnels also recover after resume and network changes."))
        row.awg_switch_handler = autostart.connect("state-set", self.toggle_autostart, profile["name"])
        grid.attach(self.control_cell(autostart, 72), 2, 0, 1, 1)

        action = Gtk.Button(label=tr("Disconnect") if profile["active"] else tr("Connect"))
        action.set_size_request(132, 36)
        action.get_child().set_ellipsize(Pango.EllipsizeMode.END)
        action.get_child().set_max_width_chars(12)
        action.set_valign(Gtk.Align.CENTER)
        action.get_style_context().add_class("destructive-action" if profile["active"] else "suggested-action")
        action.connect("clicked", lambda button: self.profile_action(button, profile["name"], row.awg_profile["active"]))
        grid.attach(self.control_cell(action, 132), 3, 0, 1, 1)

        more = Gtk.MenuButton()
        more.set_size_request(36, 36)
        more.set_valign(Gtk.Align.CENTER)
        more.set_image(Gtk.Image.new_from_icon_name("view-more-symbolic", Gtk.IconSize.BUTTON))
        more.set_tooltip_text(tr("Profile actions"))
        menu = Gtk.Menu()
        rename = Gtk.MenuItem(label=tr("Rename…"))
        rename.connect("activate", lambda item: self.rename_profile(item, row.awg_profile))
        menu.append(rename)
        edit = Gtk.MenuItem(label=tr("Edit configuration…"))
        edit.set_sensitive(not profile["active"] and profile["health"] != "connecting")
        edit.set_tooltip_text(tr("Disconnect the profile before editing. Configuration contains private keys."))
        edit.connect("activate", self.edit_profile, profile["name"])
        menu.append(edit)
        menu.append(Gtk.SeparatorMenuItem())
        details = Gtk.MenuItem(label=tr("Details"))
        details.connect("activate", self.show_status, profile["name"])
        menu.append(details)
        repair = Gtk.MenuItem(label=tr("Repair connection"))
        repair.connect("activate", self.repair_profile, profile["name"])
        menu.append(repair)
        diagnostics = Gtk.MenuItem(label=tr("Export diagnostics…"))
        diagnostics.connect("activate", self.export_diagnostics, profile["name"])
        menu.append(diagnostics)
        menu.append(Gtk.SeparatorMenuItem())
        delete = Gtk.MenuItem(label=tr("Delete profile"))
        delete.connect("activate", self.delete_profile, profile["name"])
        menu.append(delete)
        menu.show_all()
        more.set_popup(menu)
        grid.attach(self.control_cell(more, 36), 4, 0, 1, 1)
        row.add(grid)
        row.awg_detail = detail
        row.awg_profile = profile
        row.awg_dot, row.awg_title, row.awg_state = dot, title, state
        row.awg_switch, row.awg_action, row.awg_edit = autostart, action, edit
        return row

    def update_profile_row(self, row, profile):
        old = row.awg_profile
        if old["health"] != profile["health"]:
            context = row.awg_dot.get_style_context()
            context.remove_class(f"health-{old['health']}")
            context.add_class(f"health-{profile['health']}")
            state = HEALTH_LABELS.get(profile["health"], profile["health"])
            row.awg_dot.set_tooltip_text(state)
            row.awg_state.set_text(state)
        if any(old.get(key) != profile.get(key) for key in ("label", "protocol", "full_tunnel")):
            badge = profile["protocol"] + (" • Full tunnel" if profile["full_tunnel"] else "")
            row.awg_title.set_markup(
                f"<span weight='600' size='large'>{GLib.markup_escape_text(profile.get('label', profile['name']))}</span>  "
                f"<span color='#77767b'>{GLib.markup_escape_text(badge)}</span>"
            )
        detail = self.profile_detail_text(profile)
        if row.awg_detail.get_text() != detail:
            row.awg_detail.set_text(detail)
            row.awg_detail.set_tooltip_text(detail or None)
            row.awg_detail.set_visible(bool(detail))
        if row.awg_switch.get_active() != profile["enabled"]:
            row.awg_switch.handler_block(row.awg_switch_handler)
            row.awg_switch.set_active(profile["enabled"])
            row.awg_switch.handler_unblock(row.awg_switch_handler)
        if old["active"] != profile["active"]:
            row.awg_action.set_label(tr("Disconnect") if profile["active"] else tr("Connect"))
            context = row.awg_action.get_style_context()
            context.remove_class("suggested-action" if profile["active"] else "destructive-action")
            context.add_class("destructive-action" if profile["active"] else "suggested-action")
        row.awg_edit.set_sensitive(not profile["active"] and profile["health"] != "connecting")
        row.awg_profile = profile

    def profile_action(self, button, name, active):
        self.run_action(["down" if active else "up", name])

    def controls_locked(self):
        return self.busy or self.interaction is not None or self.error_visible or self.quitting

    def update_controls(self):
        if self.quitting:
            return
        self.listbox.set_sensitive(not self.controls_locked())
        for button in self.import_buttons:
            button.set_sensitive(not self.controls_locked())
        self.update_tray(self.profiles)

    def begin_interaction(self):
        if self.controls_locked():
            if self.error_dialog or self.dialog:
                (self.error_dialog or self.dialog).present()
            return None
        self.interaction = object()
        self.update_controls()
        return self.interaction

    def end_interaction(self, owner):
        if self.interaction is owner:
            self.interaction = None
            self.update_controls()

    def present_dialog(self, dialog, owner, respond):
        self.dialog = dialog
        dialog.set_modal(True)
        dialog.set_destroy_with_parent(True)

        def response(_dialog, value):
            if self.dialog is not dialog or self.quitting:
                return
            self.dialog = None
            try:
                respond(value)
            except Exception as exc:
                self.end_interaction(owner)
                self.show_error(str(exc))
            finally:
                dialog.destroy()

        def destroyed(_dialog):
            if self.dialog is dialog:
                self.dialog = None
                self.end_interaction(owner)

        dialog.connect("response", response)
        dialog.connect("destroy", destroyed)
        dialog.show_all()

    def run_action(self, args, done=None, finished=None, *, owner=None):
        if self.busy or self.quitting or self.error_visible or (self.interaction is not None and self.interaction is not owner):
            return False
        self.busy = True
        self.refresh_generation += 1
        # Operation metadata must never contain import/save configuration text.
        self.operation = (args[0], args[1] if args[0] not in {"import", "down-all"} else None)
        self.action_feedback = None
        self.update_controls()
        self.update_footer()
        def complete(result):
            self.action_feedback = (result.strip(), time.monotonic())
            if done:
                done(result)
        def on_finished():
            self.busy = False
            self.operation = None
            self.refresh_generation += 1
            self.update_controls()
            self.update_footer()
            self.refresh()
            if finished:
                finished()
        if not self.async_call(lambda: self.helper(*args), complete, on_finished, lane="action"):
            on_finished()
            return False
        return True

    def rename_profile(self, _item, profile):
        owner = self.begin_interaction()
        if owner is None:
            return
        dialog = Gtk.Dialog(title=tr("Rename profile"), transient_for=self.window, modal=True)
        dialog.add_buttons(tr("Cancel"), Gtk.ResponseType.CANCEL, tr("Rename"), Gtk.ResponseType.OK)
        box = dialog.get_content_area()
        box.set_border_width(16)
        box.set_spacing(10)
        entry = Gtk.Entry(text=profile.get("label", profile["name"]))
        entry.set_max_length(80)
        entry.set_activates_default(True)
        box.add(entry)
        box.add(Gtk.Label(label=tr("Only the display name changes; network settings stay the same.")))
        dialog.set_default_response(Gtk.ResponseType.OK)
        def respond(response):
            label = entry.get_text().strip()
            self.end_interaction(owner)
            if response == Gtk.ResponseType.OK:
                self.run_action(["rename", profile["name"], label])

        self.present_dialog(dialog, owner, respond)

    def interaction_call(self, owner, function, done):
        def failed(message):
            if self.interaction is owner:
                self.end_interaction(owner)
                self.show_error(message)

        def complete(result):
            if self.interaction is owner:
                try:
                    done(result)
                except Exception as exc:
                    failed(str(exc))

        if not self.async_call(function, complete, failed=failed):
            self.end_interaction(owner)

    def edit_profile(self, _item, name):
        owner = self.begin_interaction()
        if owner is None:
            return
        profile = next((p for p in self.profiles if p["name"] == name), None)
        if profile and (profile["active"] or profile["health"] == "connecting"):
            self.end_interaction(owner)
            return

        def open_editor(raw):
            config = json.loads(raw)
            if (not isinstance(config, dict) or not isinstance(config.get("text"), str)
                    or len(config["text"].encode("utf-8")) > MAX_CONFIG_BYTES
                    or not isinstance(config.get("revision"), str) or len(config["revision"]) > 128):
                raise ValueError("Malformed configuration response")
            revision = config["revision"]
            dialog = Gtk.Dialog(title=tr("Edit configuration"), transient_for=self.window, modal=True)
            self.editor = dialog
            self.dialog = dialog
            dialog.set_destroy_with_parent(True)
            dialog.set_default_size(680, 520)
            dialog.add_buttons(tr("Cancel"), Gtk.ResponseType.CANCEL, tr("Save"), Gtk.ResponseType.OK)
            box = dialog.get_content_area()
            box.set_border_width(16)
            box.set_spacing(12)
            warning = Gtk.Label(label=tr("Contains private keys — do not share screenshots.\nChanges apply on the next connection. The previous version is kept securely."), xalign=0)
            warning.set_line_wrap(True)
            box.pack_start(warning, False, False, 0)
            view = Gtk.TextView(monospace=True)
            view.set_wrap_mode(Gtk.WrapMode.NONE)
            buffer = view.get_buffer()
            buffer.set_text(config.pop("text"))
            scroll = Gtk.ScrolledWindow()
            scroll.set_hexpand(True)
            scroll.set_vexpand(True)
            scroll.add(view)
            box.pack_start(scroll, True, True, 0)
            save = dialog.get_widget_for_response(Gtk.ResponseType.OK)
            cancel = dialog.get_widget_for_response(Gtk.ResponseType.CANCEL)

            def destroyed(_dialog):
                buffer.set_text("")
                if self.editor is dialog:
                    self.editor = None
                if self.dialog is dialog:
                    self.dialog = None
                self.end_interaction(owner)

            dialog.connect("destroy", destroyed)
            dialog.connect("delete-event", lambda *_: self.busy)

            def restore_editor():
                if self.editor is dialog:
                    save.set_sensitive(True)
                    cancel.set_sensitive(True)
                    dialog.set_deletable(True)
                    view.set_editable(True)

            def respond(_dialog, response):
                if self.busy or self.editor is not dialog or self.quitting:
                    return
                if response != Gtk.ResponseType.OK:
                    dialog.destroy()
                    return
                text = buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), True)
                if len(text.encode()) > MAX_CONFIG_BYTES:
                    self.show_error(tr("Configuration exceeds 64 KiB"))
                    return
                save.set_sensitive(False)
                cancel.set_sensitive(False)
                dialog.set_deletable(False)
                view.set_editable(False)

                def saved(_result):
                    dialog.destroy()

                if not self.run_action(["save-config", name, json.dumps({"text": text, "revision": revision})],
                                       done=saved, finished=restore_editor, owner=owner):
                    restore_editor()

            dialog.connect("response", respond)
            dialog.show_all()
        self.interaction_call(owner, lambda: self.helper("read-config", name), open_editor)

    def toggle_autostart(self, switch, state, name):
        if state == switch.get_active():
            return False
        self.run_action(["autostart", name, "on" if state else "off"])
        return True

    def repair_profile(self, _item, name):
