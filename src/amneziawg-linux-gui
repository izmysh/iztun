APP_ID = "io.github.amneziawg_linux_gui.Client"
APP_VERSION = "0.3.0"
HELPER_SOCKET = "/run/amneziawg-linux-gui.sock"
MAX_CONFIG_BYTES = 65536
MAX_REQUEST_BYTES = 400000
MAX_RESPONSE_BYTES = 2 * 1024 * 1024
MAX_PROFILES = 512
READ_TIMEOUTS = {"list": 20, "read-config": 15, "status": 30, "diagnostics": 120}
ACTION_TIMEOUT = 420
HEALTH_LABELS = {
    "connecting": "Connecting…",
    "connected": "Connected",
    "waiting": "Waiting for handshake",
    "stale": "Handshake stale",
    "error": "Connection problem",
    "disconnected": "Disconnected",
}


def tr(english):
    return english


def human_bytes(value):
    value = int(value or 0)
    units = ("B", "KiB", "MiB", "GiB")
    for unit in units:
        if value < 1024 or unit == units[-1]:
            return f"{value:.0f} {unit}" if unit == units[0] else f"{value:.1f} {unit}"
        value /= 1024


def read_import(filename):
    if not filename or Path(filename).suffix != ".conf":
        raise ValueError("Choose a regular .conf file")
    fd = os.open(filename, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    with os.fdopen(fd, "rb") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode):
            raise ValueError("Choose a regular .conf file")
        if info.st_size > MAX_CONFIG_BYTES:
            raise ValueError("Configuration exceeds 64 KiB")
        data = stream.read(MAX_CONFIG_BYTES + 1)
    if len(data) > MAX_CONFIG_BYTES:
        raise ValueError("Configuration exceeds 64 KiB")
    return data.decode("utf-8")


def write_diagnostics(filename, report):
    target = Path(filename)
    try:
        info = target.lstat()
    except FileNotFoundError:
        pass
    else:
        if not stat.S_ISREG(info.st_mode):
            raise ValueError("Choose a regular report file")
    fd, temporary = tempfile.mkstemp(prefix=".iztun-", dir=target.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(report + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, target)
    finally:
        Path(temporary).unlink(missing_ok=True)


def parse_profiles(raw):
    profiles = json.loads(raw)
    if not isinstance(profiles, list) or len(profiles) > MAX_PROFILES:
        raise ValueError("Invalid or oversized profile list")
    names = set()
    for profile in profiles:
        if not isinstance(profile, dict):
            raise ValueError("Invalid profile record")
        name = profile.get("name")
        if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.+=-]{0,14}", name) or name in names:
            raise ValueError("Invalid or duplicate profile name")
        names.add(name)
        for key in ("active", "enabled", "full_tunnel"):
            if type(profile.get(key)) is not bool:
                raise ValueError("Invalid profile state")
        for key, default, limit in (("label", name, 80), ("protocol", "", 80),
                                    ("health", "", 64), ("last_error", "", 8192)):
            value = profile.get(key, default)
            if not isinstance(value, str) or len(value) > limit:
                raise ValueError("Invalid profile text")
            profile[key] = value
        for key in ("rx", "tx", "latest_handshake"):
            value = profile.get(key, 0)
            if type(value) is not int or not 0 <= value <= 2**64 - 1:
                raise ValueError("Invalid profile counters")
            profile[key] = value
    return profiles


