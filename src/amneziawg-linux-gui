        self.tray_signature = None
        self.refreshing = False
        self.refresh_timer = None
        self.previous_traffic = {}
        self.profile_rows = {}
        self.profile_structure = None
        self.column_groups = {}
        self.editor = None
        self.quitting = False
        self.busy = False
        self.last_refresh = 0
        self.error_visible = False
        self.operation = None
        self.action_feedback = None
        self.poll_error = ""
        self.profiles = []
        self.refresh_generation = 0
        self.refresh_pending = False
        self.pending_calls = set()
        self.socket_lock = threading.Lock()
        self.sockets = set()
        self.interaction = None
        self.dialog = None
        self.error_dialog = None
        self.import_buttons = []

    def do_activate(self):
        if self.quitting:
            return
        if not self.window:
            self.install_css()
            self.build_window()
            self.build_indicator()
        self.window.show_all()
        self.window.present()
        self.refresh()
        if self.refresh_timer is None:
            self.refresh_timer = GLib.timeout_add_seconds(5, lambda: self.refresh(timer=True))

