#!/bin/sh
# NetworkManager dispatcher hook: recover enabled tunnels after the uplink settles.
interface=${1:-}
action=${2:-}

# Ignore events generated by an AmneziaWG profile itself.
if [ -n "$interface" ] && [ -f "/etc/amneziawg/$interface.conf" ]; then
    exit 0
fi

case "$action" in
    up|dhcp4-change|dhcp6-change)
        systemctl start --no-block amneziawg-recover.service >/dev/null 2>&1 || true
        ;;
esac

exit 0
